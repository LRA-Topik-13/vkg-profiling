[PrefixDeclaration]
:		http://example.org/voc#
ex:		http://example.org/
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
foaf:		http://xmlns.com/foaf/0.1/
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	mathsci-person
target		:mathsci/person/{pid} a foaf:Person ; foaf:firstName {fname}^^xsd:string ; foaf:lastName {lname}^^xsd:string .
source		SELECT * FROM person

mappingId	mathsci-undergraduate
target		:mathsci/person/{pid} a :UndergraduateStudent .
source		SELECT * FROM person
			WHERE status = 1

mappingId	mathsci-graduate
target		:mathsci/person/{pid} a :GraduateStudent .
source		SELECT * FROM person
			WHERE status = 2

mappingId	mathsci-fullProfessor
target		:mathsci/person/{pid} a :FullProfessor .
source		SELECT * FROM person
			WHERE status = 7

mappingId	mathsci-associate-prof
target		:mathsci/person/{pid} a :AssociateProfessor .
source		SELECT * FROM person
			WHERE status = 8

mappingId	mathsci-course
target		:mathsci/course/{cid} a :Course ; :title {topic}^^xsd:string ; :isGivenAt :mathsci/university .
source		SELECT * FROM course

mappingId	mathsci-lecturer
target		:mathsci/person/{lecturer} :givesLecture :mathsci/course/{cid} .
source		SELECT * FROM course

mappingId	mathsci-assistantProfessor
target		:mathsci/person/{pid} a :AssistantProfessor .
source		SELECT * FROM person
			WHERE status = 9

mappingId	mathsci-postDoc
target		:mathsci/person/{pid} a :PostDoc .
source		SELECT * FROM person
			WHERE status = 3

mappingId	mathsci-lab-teacher
target		:mathsci/person/{lab_teacher} :givesLab :mathsci/course/{cid} .
source		SELECT * FROM course

mappingId	mathsci-registration
target		:mathsci/person/{pid} :attends :mathsci/course/{cid} .
source		SELECT *
			FROM registration
]]

