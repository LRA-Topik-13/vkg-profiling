# MySQL — matches setup.cli and uni1.docker.properties
MYSQL_DATABASE=uni1
MYSQL_USER=uni1
MYSQL_PASSWORD=uni1pwd
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
MYSQL_DEFECTED_PORT=3307

# PostgreSQL — matches setup.cli and uni2.docker.properties
POSTGRES_DB=uni2
POSTGRES_USER=uni2
POSTGRES_PASSWORD=uni2pwd

MSSQL_SA_PASSWORD=Rootpassword1!
MSSQL_USER=uni3
MSSQL_PASSWORD=uni3pwd


POSTGRES_PORT=5432
MYSQL_DEFECTED_PORT=5433
MSSQL_PORT=1433




# Ontop
ONTOP_DEV_MODE=true

# FastAPI
API_PORT=8000

# "ontology" = derive classes/properties from university.ttl at startup (recommended)
# "hardcoded" = use the static fallback lists baked into metadata_router.py
METADATA_SOURCE=hardcoded
ONTOLOGY_FILE=/app/vkg/obda/university.ttl
OBDA_FILE=/app/vkg/obda/university.obda

# Point the API at the clean (official) or defected SPARQL endpoint.
# Clean:    http://ontop-teiid:8080/sparql
# Defected: http://ontop-teiid-defected:8080/sparql
ONTOP_ENDPOINT=http://ontop-teiid:8080/sparql
