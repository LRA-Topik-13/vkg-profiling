connect

deploy /opt/jboss/jdbc/mysql-connector-java-8.0.21.jar
/subsystem=datasources/data-source=mysql-ds:add(jndi-name=java:/mysql-compsci,  enabled=true, use-java-context=true, driver-name=mysql-connector-java-8.0.21.jar, connection-url="jdbc:mysql://mysql-defected:3306/compsci",user-name=compsci, password=compscipwd)
/subsystem=datasources/data-source=mysql-ds:enable

deploy /opt/jboss/jdbc/postgresql-42.2.14.jre7.jar
/subsystem=datasources/data-source=pgsql-ds:add(jndi-name=java:/pgsql-mathsci,  enabled=true, use-java-context=true, driver-name=postgresql-42.2.14.jre7.jar, connection-url="jdbc:postgresql://pgsql-defected:5432/mathsci",user-name=mathsci, password=mathscipwd)
/subsystem=datasources/data-source=pgsql-ds:enable

deploy /opt/jboss/jdbc/mssql-jdbc-9.4.1.jre11.jar
/subsystem=datasources/data-source=mssql-ds:add(jndi-name=java:/mssql-academics,  enabled=true, use-java-context=true, driver-name=mssql-jdbc-9.4.1.jre11.jar, connection-url="jdbc:sqlserver://mssql-defected:1433;databaseName=academics;encrypt=false",user-name=academics, password=academicspwd)
/subsystem=datasources/data-source=mssql-ds:enable

deploy /opt/jboss/data-federation/universities-vdb.xml
